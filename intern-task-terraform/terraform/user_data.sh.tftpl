#!/bin/bash
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y docker.io ufw iptables-persistent
systemctl enable --now docker

if ! id appuser >/dev/null 2>&1; then
  useradd --create-home --shell /bin/bash appuser
fi
usermod -aG docker appuser
printf '%s\n' 'appuser ALL=(ALL) NOPASSWD:ALL' >/etc/sudoers.d/appuser
chmod 0440 /etc/sudoers.d/appuser

install -d -m 0755 /opt/intern-task-app/app
echo '${app_source_b64}' | base64 --decode >/opt/intern-task-app/app/app.py
echo '${dockerfile_b64}' | base64 --decode >/opt/intern-task-app/Dockerfile
docker build --tag intern-task-app:local /opt/intern-task-app

cat >/etc/systemd/system/intern-task-app.service <<'UNIT'
[Unit]
Description=Intern task application container
After=docker.service
Requires=docker.service

[Service]
Restart=always
ExecStartPre=-/usr/bin/docker rm -f intern-task-app
ExecStart=/usr/bin/docker run --name intern-task-app --publish ${app_port}:${app_port} --env PORT=${app_port} intern-task-app:local
ExecStop=/usr/bin/docker stop -t 10 intern-task-app

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload

# UFW protects host INPUT traffic and exposes only the application port. SSH
# remains restricted in the AWS security group, but the host firewall blocks
# new SSH connections by design.
ufw --force reset
ufw default deny incoming
ufw default allow outgoing
ufw allow ${app_port}/tcp
ufw --force enable

cat >/usr/local/sbin/intern-task-app-firewall <<'FIREWALL'
#!/bin/bash
set -eu
iptables -N DOCKER-USER 2>/dev/null || true
iptables -F DOCKER-USER
iptables -A DOCKER-USER -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
iptables -A DOCKER-USER -i docker0 -j ACCEPT
iptables -A DOCKER-USER -p tcp --dport ${app_port} -j ACCEPT
iptables -A DOCKER-USER -j DROP
iptables-save >/etc/iptables/rules.v4
FIREWALL
chmod 0755 /usr/local/sbin/intern-task-app-firewall

cat >/etc/systemd/system/intern-task-app-firewall.service <<'UNIT'
[Unit]
Description=Firewall rules for the intern task container
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
Before=intern-task-app.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/intern-task-app-firewall
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now intern-task-app-firewall.service
systemctl enable --now intern-task-app.service
